{
  "functions": {
    "server.js": {
      "includeFiles": [
        "css/**/*",
        "js/**/*",
        "assets/**/*",
        "index.html",
        "project-report.html"
      ]
    },
    "api/index.js": {
      "includeFiles": [
        "css/**/*",
        "js/**/*",
        "assets/**/*",
        "index.html",
        "project-report.html"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
