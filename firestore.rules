rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 0. Connection Handshake Ping (/system_handshake/{docId})
    // Allows instant connection test from Settings panel even before logging in
    // =========================================================================
    match /system_handshake/{docId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 1. Learner & User Profiles (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 2. Student Practice Attempts (/student_attempts/{attemptId})
    // =========================================================================
    match /student_attempts/{attemptId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 3. Quiz Arena Sessions (/quiz_sessions/{sessionId})
    // =========================================================================
    match /quiz_sessions/{sessionId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 4. Socratic AI Tutor Chat & Doubts History (/doubts_chat/{doubtId})
    // =========================================================================
    match /doubts_chat/{doubtId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 5. School Admin Cohort Data (/school_cohorts/{schoolId})
    // =========================================================================
    match /school_cohorts/{schoolId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 6. School Announcements (/announcements/{announcementId})
    // =========================================================================
    match /announcements/{announcementId} {
      allow read, write: if true;
    }
  }
}
