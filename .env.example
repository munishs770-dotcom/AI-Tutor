# =============================================================================
# ARYA AI TUTOR - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env locally or set these in your Vercel Project Dashboard
# =============================================================================

# 1. Server Configuration
PORT=8080
NODE_ENV=production

# 2. Google Gemini Generative AI (Optional, fallbacks to Smart Offline Socratic Engine)
GEMINI_API_KEY=AIzaSy...YourGeminiApiKeyHere

# 3. Firebase Project & Database Configuration
# Obtain these from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
FIREBASE_API_KEY=AIzaSy...YourFirebaseWebApiKeyHere
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=1029384756
FIREBASE_APP_ID=1:1029384756:web:abcdef123456

# Vercel Client-Side Exposed Environment Variables (Alternative prefix)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...YourFirebaseWebApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
